# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Manim working files (previews, partial renders, TeX cache, voice cache)
media/
voiceovers/

# Rendered videos are large: keep the verified text outputs, not the media
videos/**/*.mp4
videos/**/*.wav
videos/**/*.mp3
videos/**/frames/

# Your textbook / lecture PDFs are copyrighted — keep them local only
materials/**/*.pdf
materials/**/*.pptx
# Text extracted from course materials is also the instructor's IP — local only
materials/**/extracted/
materials/**/*.txt

# Render working files and QA frames (re-created by every render)
videos/**/media/
videos/**/frames/
videos/**/render_job.json

# generated study files (progress.json itself is kept)
student/sessions/
student/tests/
student/progress.html
